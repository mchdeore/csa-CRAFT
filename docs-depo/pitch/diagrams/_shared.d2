vars: {
  d2-config: {
    layout-engine: tala
  }
}
style: {
  fill: transparent
}
classes: {
  actor:    { style.fill: "#D9D9D9"; style.stroke: "#333333" }
  external: { style.fill: "#FAFAFA"; style.stroke: "#666666"; style.italic: true }
  planned:  { style.stroke-dash: 5 }
  auth:     { style.fill: "#DDE5F0"; style.stroke: "#264478"; style.font-color: "#264478" }
  audit:    { style.fill: "#DFEBDF"; style.stroke: "#2F5E3A"; style.font-color: "#2F5E3A" }
  terminal: { shape: oval; style.fill: "#EEEEEE"; style.stroke: "#333333"; style.stroke-dash: 3 }
  gate:     { shape: hexagon; style.fill: "#DDE5F0"; style.stroke: "#264478" }
  store:    { shape: cylinder }
  cloud_svc:{ shape: cloud; style.italic: true }
}
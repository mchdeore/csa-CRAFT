{
  "typeCheckingMode": "standard",
  "venvPath": ".",
  "venv": ".venv",
  "include": ["."],
  "exclude": ["venv", ".venv", "tests", "workspaces"],
  "reportMissingTypeStubs": false,
  "reportUnknownParameterType": "warning",
  "reportUnknownVariableType": "warning",
  "reportUnknownMemberType": "warning"
}
